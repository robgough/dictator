# macOS
.DS_Store

# Xcode build / user state
DerivedData/
.derivedData*/
build/
*.xcuserstate
*.xcuserdatad/

# xcuserdata inside the xcodeproj package
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/project.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/

# Generated by xcodegen — project.yml is the source of truth.
Dictator.xcodeproj/

# SwiftPM local caches (deps are pulled into Xcode's SPM cache, not this folder)
.build/
.swiftpm/

# Editor noise
*.swp
*.swo
.idea/
.vscode/

# Local env (DICTATOR_TEAM_ID etc.) — never committed. Use .env.example
# as a template.
.env

# Throwaway scratch directories (one-off spikes, reference snippets).
scratch/

# App Store screenshots — large PNGs regenerated by the screenshot tooling;
# not source of truth, easier to rebuild than to track.
screenshots/

# Local Claude Code per-developer settings + Playwright MCP browser cache.
# Neither is meant to be shared across the team.
.claude/
.playwright-mcp/
