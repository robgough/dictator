# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — it never leaves your machine.
#
# Your 10-character Apple Developer Team ID. Find it in:
#   Xcode → Settings → Accounts → your Apple ID → next to "Personal Team",
# or by running `codesign -dv` on any Mac app you've signed.
#
# When set, the build uses your Personal Team certificate which keeps macOS
# TCC (Mic + Accessibility) permissions stable across rebuilds.
# When unset, the build falls back to ad-hoc signing and you'll be prompted
# for permissions again after every Clean Build Folder.
DICTATOR_TEAM_ID=
